---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MusicPlayer from '../../components/MusicPlayer.astro';
import { PLAYLISTS } from '../../data/playlists';
import library from '../../generated/music-library.json';
export function getStaticPaths() { const musicPlaylists = library.playlists as Record<string, any[]>; return PLAYLISTS.flatMap((playlist) => [{ params: { slug: playlist.slug }, props: { playlist, tracks: musicPlaylists[playlist.slug] ?? [] } }, ...(playlist.children || []).map((child) => ({ params: { slug: `${playlist.slug}/${child.slug}` }, props: { playlist: child, tracks: musicPlaylists[`${playlist.slug}/${child.directory}`] ?? [] } }))]); }
const { playlist, tracks } = Astro.props;
---
<BaseLayout title={playlist.title}><a class="back-link" href={playlist.children ? '/playlists/' : '/playlists/post-rock-punk/'} aria-label="返回">← 返回</a>{playlist.children ? <section class="topic-grid">{playlist.children.map((child) => <a class:list={['topic-card', `playlist-${child.slug}`]} href={`/playlists/${playlist.slug}/${child.slug}/`}><h2>{child.title}</h2><p>{child.description}</p><i>OPEN PLAYLIST →</i></a>)}</section> : <MusicPlayer playlist={playlist} tracks={tracks} />}</BaseLayout>
