---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { changeLog, formatChangeTime, type ChangeLogEntry } from '../../data/changelog';

export function getStaticPaths() {
  return changeLog.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: ChangeLogEntry };
---
<BaseLayout title={entry.title}><article class="post-page change-detail"><p class="eyebrow">CHANGE LOG / APPLIED</p><h1>{entry.title}</h1><dl class="change-meta"><dt>应用时间</dt><dd><time datetime={entry.appliedAt}>{formatChangeTime(entry.appliedAt)}</time></dd></dl><section class="change-body"><h2>改动详情</h2><ul>{entry.details.map(detail => <li>{detail}</li>)}</ul></section><a class="change-back" href="/journal/">← 返回日志</a></article></BaseLayout>
