---
import BaseLayout from '../layouts/BaseLayout.astro';
const links=[['乃春的Github主页','chlors-creator','https://github.com/'],['如果没有如果的Github主页','ruguo0119','https://github.com/ruguo0119'],['时默昔的Github主页','MercyGrey','https://github.com/MercyGrey'],['你的ai桌宠','现已上架steam','https://store.steampowered.com/app/4417720/ai/?l=schinese'],['Phaleristics in China','勋章中国·论坛','https://forum.phaleric.com/']];
---
<BaseLayout title="友链"><header class="report-head"><div><p class="eyebrow">CONNECTED NODES / {String(links.length).padStart(2,'0')}</p><h1>友链</h1></div></header><section class="topic-grid">{links.map((link,i)=><a class:list={['topic-card', link[2].startsWith('https://github.com/') && 'github-link', link[0] === 'Phaleristics in China' && 'phaleristics-link', link[0] === '你的ai桌宠' && 'ai-pet-link']} href={link[2]} target={link[2].startsWith('http')?'_blank':undefined} rel={link[2].startsWith('http')?'noopener noreferrer':undefined}><span>NODE_{String(i+1).padStart(3,'0')} // SYNC_OK</span><h2>{link[0]}</h2><p>{link[1]}</p><i>OPEN NODE →</i></a>)}</section></BaseLayout>
