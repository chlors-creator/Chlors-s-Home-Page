---
import BaseLayout from '../layouts/BaseLayout.astro';
import { changeLog, formatChangeDate } from '../data/changelog';
---
<BaseLayout title="日志"><header class="report-head"><div><p class="eyebrow">CHANGE LOG / INDEX</p><h1>日志</h1></div><div class="report-meta">{changeLog.length} CHANGES<br />SORT: NEWEST</div></header><section class="archive-list"><div class="year"><span>2026</span><small>Change_Record</small></div>{changeLog.map(entry=><a class="post" href={`/journal/${entry.slug}/`}><time datetime={entry.appliedAt}>{formatChangeDate(entry.appliedAt)}</time><h3>{entry.title}</h3><span class="arrow">→</span></a>)}</section></BaseLayout>
