---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PLAYLISTS } from '../data/playlists';
---
<BaseLayout title="控制台"><section class="console-page"><header class="report-head"><div><p class="eyebrow">PRIVATE CONSOLE</p><h1>控制台</h1></div></header><div data-console-status class="form-note"></div><form class="editor-form" data-login-form><label>账号<input name="username" autocomplete="username" required /></label><label>密码<input name="password" type="password" autocomplete="current-password" required /></label><button type="submit">登录 →</button></form><div data-console-panel hidden><button type="button" data-logout>退出登录</button><form class="editor-form" data-post-form><h2>上传文章</h2><label>Markdown 正文<input name="bodyFile" type="file" accept=".md,.markdown,text/markdown" required /></label><label>标题<input name="title" required /></label><label>日期<input name="date" type="date" required /></label><label>专题<input name="topic" required /></label><label>专题 slug<input name="topicSlug" required /></label><label>标签<input name="tags" /></label><label>摘要<textarea name="description" rows="3"></textarea></label><button type="submit">发布文章 →</button></form><form class="editor-form" data-music-form><h2>上传音乐</h2><label>MP3 文件<input name="file" type="file" accept="audio/mpeg,.mp3" required /></label><label>歌单<select name="directory" required><option value="" disabled selected>请选择歌单</option>{PLAYLISTS.map((playlist)=><option value={playlist.directory}>{playlist.title}</option>)}</select></label><button type="submit">上传音乐 →</button></form></div></section><script is:inline>const statusEl=document.querySelector('[data-console-status]'),login=document.querySelector('[data-login-form]'),panel=document.querySelector('[data-console-panel]');const setState=ok=>{login.hidden=ok;panel.hidden=!ok;statusEl.textContent=ok?'已登录':'请登录控制台'};fetch('/api/auth').then(r=>r.json()).then(d=>setState(d.authenticated));login.addEventListener('submit',async e=>{e.preventDefault();const body=Object.fromEntries(new FormData(login));const r=await fetch('/api/auth',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(r.ok)setState(true);else statusEl.textContent=d.error||'登录失败'});document.querySelector('[data-logout]').addEventListener('click',async()=>{await fetch('/api/auth',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'logout'})});setState(false)});document.querySelector('[data-post-form]').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,b=new FormData(f),file=b.get('bodyFile');b.delete('bodyFile');b.set('body',await file.text());const r=await fetch('/api/publish',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(b))});statusEl.textContent=(await r.json()).error||'文章已提交'});document.querySelector('[data-music-form]').addEventListener('submit',async e=>{e.preventDefault();const r=await fetch('/api/upload-music',{method:'POST',body:new FormData(e.currentTarget)});statusEl.textContent=(await r.json()).error||'音乐已提交'});</script></BaseLayout>
