---
import { PLAYLISTS } from '../data/playlists';
const { kind } = Astro.props;
const article = kind === 'article';
const lyrics = kind === 'lyrics';
---
<section class="console-page console-subpage" data-console-root data-upload-page={kind}>
  <a class="back-link" href="/console/">← 返回</a>

  <header class="report-head">
    <div>
      <p class="eyebrow">PRIVATE CONSOLE / {kind.toUpperCase()}</p>
      <h1>{article ? '上传文章' : lyrics ? '上传歌词' : '上传音乐'}</h1>
    </div>
  </header>

  <div data-console-status class="console-toast" role="status" aria-live="polite"></div>

  {article ? (
    <form class="editor-form" data-post-form>
      <label>
        Markdown 正文
        <input name="bodyFile" type="file" accept=".md,.markdown,text/markdown" required />
      </label>
      <label>
        标题
        <input name="title" required />
      </label>
      <label>
        日期
        <input name="date" type="date" required />
      </label>
      <label>
        专题
        <input name="topic" required />
      </label>
      <label>
        标签
        <input name="tags" />
      </label>
      <label>
        摘要
        <textarea name="description" rows="3"></textarea>
      </label>
      <button type="submit">发布文章 →</button>
    </form>
  ) : (
    <form
      class="editor-form"
      data-mp3-form={kind === 'music' ? '' : undefined}
      data-lrc-form={lyrics ? '' : undefined}
    >
      <label>
        {lyrics ? 'LRC 文件' : 'MP3 文件'}
        <input
          name="file"
          type="file"
          accept={lyrics ? '.lrc,text/plain' : 'audio/mpeg,.mp3'}
          required
        />
      </label>
      <label>
        歌单
        <select name="directory" required>
          <option value="" disabled selected>请选择歌单</option>
          {PLAYLISTS.map((playlist) => (
            <option value={playlist.directory}>{playlist.title}</option>
          ))}
        </select>
      </label>
      <button type="submit">{lyrics ? '上传歌词' : '上传音乐'} →</button>
    </form>
  )}

  <dialog data-file-conflict>
    <form method="dialog" data-conflict-content>
      <h2>文件已存在</h2>
      <hr />
      <div class="conflict-files">
        <div>
          <strong>待上传文件</strong>
          <p data-incoming-name></p>
          <p data-incoming-meta></p>
        </div>
        <div>
          <strong>已存在文件</strong>
          <p data-existing-name></p>
          <p data-existing-meta></p>
        </div>
      </div>
      <div class="conflict-actions">
        <button type="button" data-overwrite>覆盖</button>
        <button type="button" data-keep-existing>保留</button>
      </div>
    </form>
  </dialog>
</section>
